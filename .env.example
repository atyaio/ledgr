# Copy to .env (gitignored). Only read by `docker compose --profile hosted` and deploy/backup.sh.

# Domain Caddy serves and gets a Let's Encrypt certificate for. Its A record must point at this server first.
LEDGR_DOMAIN=admin.example.com

# Where the raw app port is published on the host. Default loopback only; 0.0.0.0 exposes :4848 on the LAN.
#LEDGR_BIND=127.0.0.1
#LEDGR_PORT=4848

# rclone destination for deploy/backup.sh (Cloudflare R2, Backblaze B2, S3, Google Drive...). Unset = local backups only.
#LEDGR_BACKUP_REMOTE=r2:ledgr-backups/my-business
# Local backup files to keep in .ledgr/backups/
#LEDGR_BACKUP_KEEP=14
