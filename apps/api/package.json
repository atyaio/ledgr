{
  "name": "@atyaio/ledgr-api",
  "version": "0.1.0",
  "description": "ledgr API: NestJS + Prisma (SQLite) backend, migrations and setup helpers used by the @atyaio/ledgr CLI.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "prisma/migrations",
    "prisma/schema.prisma"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atyaio/ledgr.git",
    "directory": "apps/api"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "pnpm prisma:generate && nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@atyaio/ledgr-shared": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^12.6.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json",
          "diagnostics": false
        }
      ]
    }
  }
}
