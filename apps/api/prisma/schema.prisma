generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model Stakeholder {
  id           String   @id @default(cuid())
  name         String
  nameAr       String?
  email        String?
  sharePercent Float    @default(0)
  active       Boolean  @default(true)
  joinedAt     String?
  notes        String?
  color        String   @default("#5B8DEF")
  customFields String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paidExpenses    Expense[]      @relation("PaidBy")
  receivedRevenue Revenue[]      @relation("ReceivedBy")
  splits          ExpenseSplit[]
  settlementsFrom Settlement[]   @relation("SettlementFrom")
  settlementsTo   Settlement[]   @relation("SettlementTo")
}

model Category {
  id                 String   @id @default(cuid())
  name               String
  nameAr             String?
  kind               String // expense | revenue
  color              String   @default("#5B8DEF")
  monthlyBudgetMinor Int?
  isDefault          Boolean  @default(false)
  archived           Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  expenses Expense[]
  revenue  Revenue[]

  @@unique([kind, name])
}

model Expense {
  id                  String   @id @default(cuid())
  date                String // YYYY-MM-DD
  amountMinor         Int
  description         String
  categoryId          String
  paidByStakeholderId String?
  vendor              String?
  notes               String?
  splitMode           String   @default("ownership") // ownership | custom
  recurringRuleId     String?
  customFields        String   @default("{}")
  importBatchId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  paidBy        Stakeholder?   @relation("PaidBy", fields: [paidByStakeholderId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule?   @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  splits        ExpenseSplit[]
  payments      ExpensePayment[]

  @@index([date])
  @@index([categoryId])
  @@index([paidByStakeholderId])
}

model ExpenseSplit {
  id            String @id @default(cuid())
  expenseId     String
  stakeholderId String
  sharePercent  Float
  amountMinor   Int

  expense     Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@unique([expenseId, stakeholderId])
  @@index([stakeholderId])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String?
  color     String   @default("#5B8DEF")
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments        RevenuePayment[]
  expensePayments ExpensePayment[]
}

/// Part of an expense paid through one payment method (cash, card…); the expense's
/// amountMinor is the sum of its payments when any exist.
model ExpensePayment {
  id              String @id @default(cuid())
  expenseId       String
  paymentMethodId String
  amountMinor     Int

  expense       Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([expenseId, paymentMethodId])
  @@index([paymentMethodId])
}

/// Part of a revenue entry received through one payment method. A revenue row can
/// have one amount per method (cash + visa + …); the row's amountMinor is their sum.
model RevenuePayment {
  id              String @id @default(cuid())
  revenueId       String
  paymentMethodId String
  amountMinor     Int

  revenue       Revenue       @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([revenueId, paymentMethodId])
  @@index([paymentMethodId])
}

model Revenue {
  id                      String   @id @default(cuid())
  date                    String
  amountMinor             Int
  description             String
  categoryId              String?
  source                  String?
  receivedByStakeholderId String?
  notes                   String?
  recurringRuleId         String?
  customFields            String   @default("{}")
  importBatchId           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receivedBy    Stakeholder?     @relation("ReceivedBy", fields: [receivedByStakeholderId], references: [id], onDelete: SetNull)
  payments      RevenuePayment[]
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  posShift      PosShift?

  @@index([date])
  @@index([categoryId])
}

model Settlement {
  id                String   @id @default(cuid())
  date              String
  fromStakeholderId String
  toStakeholderId   String? // null = company pool
  amountMinor       Int
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  from Stakeholder  @relation("SettlementFrom", fields: [fromStakeholderId], references: [id], onDelete: Cascade)
  to   Stakeholder? @relation("SettlementTo", fields: [toStakeholderId], references: [id], onDelete: SetNull)

  @@index([date])
}

model CustomFieldDefinition {
  id        String   @id @default(cuid())
  entity    String // expense | revenue | stakeholder
  key       String
  label     String
  labelAr   String?
  type      String // text | number | money | date | boolean | select
  options   String   @default("[]")
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, key])
}

model RecurringRule {
  id              String   @id @default(cuid())
  kind            String // expense | revenue
  name            String
  frequency       String // daily | weekly | monthly | quarterly | yearly
  interval        Int      @default(1)
  startDate       String
  endDate         String?
  nextRunAt       String
  active          Boolean  @default(true)
  template        String // JSON RecurringTemplate
  lastGeneratedAt String?
  generatedCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expenses Expense[]
  revenue  Revenue[]
}

model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String
  actorEmail String
  action     String
  entity     String
  entityId   String?
  before     String?
  after      String?

  @@index([entity, entityId])
  @@index([at])
}

// ─── Integrations (POS systems) ───────────────────────────────────────────────

/// One row per connected provider ("loyverse"). The token lives here, in data.db, never in config.json.
model Integration {
  id              String    @id @default(cuid())
  provider        String    @unique
  accessToken     String
  merchantId      String?
  merchantName    String?
  currency        String?
  decimalPlaces   Int       @default(2)
  /// JSON: provider settings (stores, payment types to pull, category, method map)
  settings        String    @default("{}")
  /// JSON: cached provider reference data (stores, payment types)
  meta            String    @default("{}")
  lastItemsSyncAt DateTime?
  lastShiftPullAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PosCategory {
  id         String    @id @default(cuid())
  provider   String
  externalId String
  name       String
  color      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items PosItem[]

  @@unique([provider, externalId])
}

model PosItem {
  id           String    @id @default(cuid())
  provider     String
  externalId   String
  name         String
  categoryId   String?
  sku          String?
  priceMinor   Int?
  costMinor    Int?
  variantCount Int       @default(1)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category PosCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales    PosSale[]

  @@unique([provider, externalId])
  @@index([categoryId])
}

/// A closed POS shift that was pulled into the ledger. `revenueId` is the row it produced.
model PosShift {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  storeId    String
  storeName  String?
  openedAt   DateTime
  closedAt   DateTime
  /// JSON: the provider's shift object as received
  raw        String
  receipts   Int      @default(0)
  revenueId  String?  @unique
  pulledAt   DateTime @default(now())

  revenue Revenue?  @relation(fields: [revenueId], references: [id], onDelete: SetNull)
  sales   PosSale[]

  @@unique([provider, externalId])
}

/// What sold during a pulled shift, aggregated per item (variant).
model PosSale {
  id             String  @id @default(cuid())
  shiftId        String
  itemId         String?
  externalItemId String?
  itemName       String
  variantName    String?
  sku            String?
  categoryName   String?
  quantity       Float
  grossMinor     Int
  netMinor       Int
  costMinor      Int

  shift PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  item  PosItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([itemId])
}
