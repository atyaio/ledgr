{
  "name": "ledgr-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter @atyaio/ledgr-shared build && pnpm -r --filter @atyaio/ledgr-api --filter @atyaio/ledgr-web build && pnpm --filter @atyaio/ledgr build",
    "dev": "pnpm -r --parallel --filter @atyaio/ledgr-api --filter @atyaio/ledgr-web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ledgr": "node packages/cli/dist/index.js",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
