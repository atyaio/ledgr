{
  "name": "ledgr-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --filter @ledgr/shared build && pnpm -r --filter @ledgr/api --filter @ledgr/web build && pnpm --filter ledgr build",
    "dev": "pnpm -r --parallel --filter @ledgr/api --filter @ledgr/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ledgr": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
